# Dracula theme for dunst (https://draculatheme.com). Only styling is set
# here; everything else uses dunst's built-in defaults (same as the system
# /etc/dunst/dunstrc).

[global]
    font = MesloLGS NF 10
    frame_width = 2
    separator_color = frame

[urgency_low]
    background = "#282A36"
    foreground = "#F8F8F2"
    frame_color = "#6272A4"
    highlight = "#6272A4"

[urgency_normal]
    background = "#282A36"
    foreground = "#F8F8F2"
    frame_color = "#BD93F9"
    highlight = "#BD93F9"

[urgency_critical]
    background = "#282A36"
    foreground = "#F8F8F2"
    frame_color = "#FF5555"
    highlight = "#FF5555"
