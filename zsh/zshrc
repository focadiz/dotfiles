# Dracula palette for the Linux console (tty1-6). Must run before `clear` so the
# whole screen is repainted with the new background. Only on a real VT: other
# terminals would swallow the rest of the output as an unterminated OSC sequence.
if [[ $TERM == linux && $TTY == /dev/tty[0-9]* ]]; then
  printf '\e]P%s' 0282A36 1FF5555 250FA7B 3F1FA8C 4BD93F9 5FF79C6 68BE9FD 7F8F8F2 \
                  86272A4 9FF6E6E A69FF94 BFFFFA5 CD6ACFF DFF92DF EA4FFFF FFFFFFF
fi
clear
# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
# Skipped on the Linux console: the cached prompt may contain Nerd Font glyphs from a GUI terminal.
if [[ $TERM != linux && -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Lines configured by zsh-newuser-install
HISTFILE=~/.histfile
HISTSIZE=1000
SAVEHIST=1000
setopt autocd extendedglob notify interactive_comments
unsetopt beep nomatch
bindkey -e
# End of lines configured by zsh-newuser-install
# The following lines were added by compinstall
zstyle :compinstall filename '/home/felipe/.zshrc'

export JAVA_HOME=/usr/lib/jvm/default

autoload -Uz compinit
compinit
# End of lines added by compinstall

source /usr/share/zsh-theme-powerlevel10k/powerlevel10k.zsh-theme

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# Dracula colors for ls and for file lists in tab completion.
eval "$(dircolors -b ${${(%):-%x}:A:h}/dracula.dircolors)"  # next to the real (symlinked) zshrc
alias ls='ls --color=auto'
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}

# Dracula colors for grep: pink matches, purple file names, green line numbers,
# grey separators.
export GREP_COLORS='ms=01;38;2;255;121;198:mc=01;38;2;255;121;198:fn=38;2;189;147;249:ln=38;2;80;250;123:bn=38;2;80;250;123:se=38;2;98;114;164'
alias grep='grep --color=auto'

# Dracula colors for man pages (and other bold/underlined text in less), from
# https://github.com/dracula/man-pages (MIT). The basic colors map to Dracula
# through the urxvt palette and the console palette above.
export LESS_TERMCAP_mb=$'\e[1;31m'      # blink: red
export LESS_TERMCAP_md=$'\e[1;34m'      # bold (headings, options): purple
export LESS_TERMCAP_so=$'\e[01;45;37m'  # standout (status line, search hits): pink
export LESS_TERMCAP_us=$'\e[01;36m'     # underline (arguments): cyan
export LESS_TERMCAP_me=$'\e[0m'
export LESS_TERMCAP_se=$'\e[0m'
export LESS_TERMCAP_ue=$'\e[0m'
export GROFF_NO_SGR=1  # make groff emit the bold/underline that less recolors

# Suggest commands from history as you type, in Dracula's comment grey.
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=#6272A4'
source /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh

# Syntax highlighting with Dracula colors. The plugin must be sourced last.
source ${${(%):-%x}:A:h}/dracula-syntax-highlighting.zsh  # next to the real (symlinked) zshrc
source /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
